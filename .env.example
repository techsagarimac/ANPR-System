# ANPR System configuration
# Copy to .env and adjust for your environment.

CAMERA_SOURCE=0
CAMERA_ID=cam-01
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

VEHICLE_MODEL_PATH=models/vehicle_model.pt
PLATE_MODEL_PATH=models/plate_model.pt
ALLOW_PRETRAINED_VEHICLE_FALLBACK=true
ALLOW_OPENCV_PLATE_FALLBACK=true

VEHICLE_CONFIDENCE=0.40
PLATE_CONFIDENCE=0.40
OCR_CONFIDENCE=0.60

DUPLICATE_COOLDOWN_SECONDS=10
PROCESS_EVERY_N_FRAMES=2
TRACK_IOU_THRESHOLD=0.30
TRACK_MAX_AGE_FRAMES=20

DATABASE_URL=sqlite:///./data/database.db

ANPR_DISABLE_ENGINE=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
